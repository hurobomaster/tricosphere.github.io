<mujoco model="faithful_primitive_single_finger">
  
  <!-- ============================================================
       Tuned version based on XL330-M288 servo specs
       Gear ratio: 288.4:1, Stall torque: 0.52 N·m @ 5V
       Key changes vs reference:
         - armature: 0.003 -> 0.012 (reflected rotor inertia through 288:1 gearbox)
         - damping on passive joints: 1 -> 5 (energy dissipation)
         - frictionloss on passive joints: 0.02 -> 0.05 (Coulomb friction)
         - actuator kp: 100 -> 150, kv: 5 -> 8 (stiffer tracking)
         - tightened equality constraints (reduced closed-chain stretch)
       ============================================================ -->
  
  <compiler angle="degree" coordinate="local" eulerseq="xyz"/>
  
  
  <option timestep="0.0005" iterations="200" tolerance="1e-8" solver="Newton">
    
    
    <flag contact="disable"/>
    
  
  </option>
  
  
  <default>
    
    <!-- Base defaults for all joints -->
    <joint damping="0.5" armature="0.001" frictionloss="0.03"/>
    
    <!-- Silicone tip contact parameters -->
    <default class="silicone_tip">
      
      
      <geom type="sphere" size="0.0082" friction="2.0 0.02 0.0001" solref="0.0005 200.0" solimp="0.99 0.995 0.0001" contype="1" conaffinity="1" condim="6" priority="1"/>
      
    
    </default>
    
    
    <geom type="capsule" rgba="0.7 0.7 0.7 0.6" contype="0" conaffinity="0"/>
    
  
  </default>
  
  
  <asset>
    
    
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    
    
    <texture name="groundplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="100" height="100"/>
    
    
    <material name="groundplane" texture="groundplane" texrepeat="10 10"/>
    
  
  </asset>
  
  
