  </worldbody>
  
  
  <equality>
    
    <!-- Tighter CSPM inner constraint: reduced time constant for stiffer coupling -->
    <connect name="CSPM_inner" site1="site_1_connect" site2="site_4_connect" solref="0.000008 1" solimp="0.96 0.999 0.0001"/>
    
    <!-- Tighter CSPM outer constraint -->
    <connect name="CSPM_outer" site1="site_2_connect" site2="site_3_connect" solref="0.000008 1" solimp="0.96 0.999 0.0001"/>
    
    <!-- Tighter distal pivot constraint -->
    <connect name="Distal_pivot" site1="site_parallel_short_connect" site2="site_parallel_long_connect" solref="0.0003 1" solimp="0.99 0.999 0.001"/>
    
    <!-- Tighter distal axis constraint -->
    <connect name="Distal_axis" site1="site_parallel_short_connect_2" site2="site_parallel_long_connect_2" solref="0.0003 1" solimp="0.99 0.999 0.001"/>
    
  
  </equality>
  
  
  <actuator>
    
    <!-- XL330-M288 actuators with improved gains:
         kp=150 (+50%) for stiffer position tracking
         kv=8 (+60%) for better velocity damping
         ctrlrange unchanged (in radians) -->
    
    <position name="act_1_1" joint="joint_1_1" kp="150" kv="8" ctrllimited="true" ctrlrange="-0.576 3.72"/>
    
    <position name="act_2_1" joint="joint_2_1" kp="150" kv="8" ctrllimited="true" ctrlrange="-2.147 2.147"/>
    
    <position name="act_3_1" joint="joint_3_1" kp="150" kv="8" ctrllimited="true" ctrlrange="-2.147 2.147"/>
    
    <position name="act_4_1" joint="joint_4_1" kp="150" kv="8" ctrllimited="true" ctrlrange="-0.576 3.72"/>
  
  </actuator>
  

